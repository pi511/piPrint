<Window x:Class="PiPrint.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PiPrint.App.Views"
        xmlns:vm="clr-namespace:PiPrint.App.ViewModels"
        xmlns:models="clr-namespace:PiPrint.App.Models"
        mc:Ignorable="d"
        Title="{DynamicResource Str_AppTitle}" 
        Height="820" Width="1280"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Control" Key="Add" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding ZoomFitCommand}"/>
        <KeyBinding Modifiers="Control" Key="NumPad0" Command="{Binding ZoomFitCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- App Bar -->
            <RowDefinition Height="Auto"/> <!-- Secondary Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main Body -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top App Bar -->
        <Border Grid.Row="0" Background="#1E293B" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#3B82F6" CornerRadius="6" Width="34" Height="34" Margin="0,0,10,0">
                        <TextBlock Text="π" Foreground="White" FontWeight="Bold" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PiPrint" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource Str_AppSubtitle}" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Savings Banner -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#064E3B" 
                        CornerRadius="20" Padding="14,6" Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌿 " FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SavingsStatistics}" Foreground="#A7F3D0" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Quick File Actions & Language Switcher -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenFileCommand}" Content="{DynamicResource Str_OpenDocument}" 
                            Background="#334155" Foreground="White" BorderThickness="0" Padding="12,6" Margin="4,0" Cursor="Hand"/>
                    <Button Command="{Binding LoadSampleCommand}" Content="{DynamicResource Str_LoadSample}" 
                            Background="#334155" Foreground="White" BorderThickness="0" Padding="12,6" Margin="4,0" Cursor="Hand"/>
                    <Button Command="{Binding ClearAllCommand}" Content="{DynamicResource Str_ClearAll}" 
                            Background="#475569" Foreground="#FCA5A5" BorderThickness="0" Padding="10,6" Margin="4,0" Cursor="Hand"/>

                    <!-- Language Dropdown -->
                    <Border Background="#334155" CornerRadius="4" Margin="6,0,0,0" Padding="2">
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                  DisplayMemberPath="DisplayName" Width="110" Height="28"
                                  BorderThickness="0" Cursor="Hand"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Secondary Toolbar: Imposition Modes & Quick Tools -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Layout Mode Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str_LayoutMode}" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    
                    <RadioButton Content="{DynamicResource Str_Layout1Up}" IsChecked="{Binding IsOneUp, Mode=OneWay}"
                                 Command="{Binding SetLayoutCommand}" CommandParameter="OneUp"
                                 Style="{StaticResource {x:Type ToggleButton}}" Padding="12,5" Margin="2,0" Cursor="Hand"/>
                    <RadioButton Content="{DynamicResource Str_Layout2Up}" IsChecked="{Binding IsTwoUp, Mode=OneWay}"
                                 Command="{Binding SetLayoutCommand}" CommandParameter="TwoUp"
                                 Style="{StaticResource {x:Type ToggleButton}}" Padding="12,5" Margin="2,0" Cursor="Hand"/>
                    <RadioButton Content="{DynamicResource Str_Layout4Up}" IsChecked="{Binding IsFourUp, Mode=OneWay}"
                                 Command="{Binding SetLayoutCommand}" CommandParameter="FourUp"
                                 Style="{StaticResource {x:Type ToggleButton}}" Padding="12,5" Margin="2,0" Cursor="Hand"/>
                    <RadioButton Content="{DynamicResource Str_Layout8Up}" IsChecked="{Binding IsEightUp, Mode=OneWay}"
                                 Command="{Binding SetLayoutCommand}" CommandParameter="EightUp"
                                 Style="{StaticResource {x:Type ToggleButton}}" Padding="12,5" Margin="2,0" Cursor="Hand"/>
                    <RadioButton Content="{DynamicResource Str_LayoutBooklet}" IsChecked="{Binding IsBooklet, Mode=OneWay}"
                                 Command="{Binding SetLayoutCommand}" CommandParameter="Booklet"
                                 Style="{StaticResource {x:Type ToggleButton}}" Padding="12,5" Margin="2,0" Cursor="Hand"/>
                </StackPanel>

                <!-- Page Operations -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding DeleteBlankPagesCommand}" Content="{DynamicResource Str_RemoveBlanks}" 
                            Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Padding="10,5" Margin="4,0" Cursor="Hand"/>
                    <Button Command="{Binding RotateCWCommand}" Content="{DynamicResource Str_Rotate90}" 
                            Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Padding="10,5" Margin="4,0" Cursor="Hand"/>
                    <Button Command="{Binding DeleteSelectedPageCommand}" Content="{DynamicResource Str_DeletePage}" 
                            Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" Padding="10,5" Margin="4,0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Main Workspace: 3 Columns -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/> <!-- Left: Page Organizer Thumbnails -->
                <ColumnDefinition Width="*"/>   <!-- Center: Sheet Preview / Empty State -->
                <ColumnDefinition Width="320"/> <!-- Right: Print Settings & Output -->
            </Grid.ColumnDefinitions>

            <!-- Column 1: Page Thumbnails Gallery -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <TextBlock Text="{DynamicResource Str_PageOrganizer}" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding MovePageUpCommand}" Content="▲" ToolTip="Move Up" 
                                        Width="26" Height="24" Background="#E2E8F0" BorderThickness="0" Margin="2,0" Cursor="Hand"/>
                                <Button Command="{Binding MovePageDownCommand}" Content="▼" ToolTip="Move Down" 
                                        Width="26" Height="24" Background="#E2E8F0" BorderThickness="0" Margin="2,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox x:Name="PagesListBox" Grid.Row="1" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Padding="8" Background="Transparent"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="PagesListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="PagesListBox_PreviewMouseMove"
                             DragOver="PagesListBox_DragOver"
                             Drop="PagesListBox_Drop">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,4"/>
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="AllowDrop" Value="True"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PageItem}">
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mini Thumbnail -->
                                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Width="55" Height="75" CornerRadius="2">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform">
                                                    <Image.RenderTransform>
                                                        <RotateTransform Angle="{Binding RotationAngle}" CenterX="0.5" CenterY="0.5"/>
                                                    </Image.RenderTransform>
                                                </Image>
                                                <Border Background="#F97316" Visibility="{Binding IsBlank, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Padding="2,1">
                                                    <TextBlock Text="{DynamicResource Str_BlankBadge}" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Page Metadata -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding DisplayNumber, StringFormat='Page {0}'}" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                            <TextBlock Text="{Binding SourceJobName}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding RotationAngle, StringFormat='Rotation: {0}°'}" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>

                                        <!-- Selected Marker -->
                                        <Border Grid.Column="2" Width="4" Background="#3B82F6" CornerRadius="2"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Column 2: Center Interactive Sheet Preview or Empty State -->
            <Grid Grid.Column="1">
                <!-- Case A: Document Loaded -->
                <Grid Visibility="{Binding HasPages, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <views:SheetPreviewControl Grid.Row="0"
                                               CurrentSheet="{Binding CurrentSheet}"
                                               ZoomLevel="{Binding ZoomLevel}"
                                               Watermark="{Binding CurrentWatermark}"
                                               CustomWatermarkText="{Binding CustomWatermarkText}"
                                               IsGrayscale="{Binding IsGrayscale}"/>

                    <!-- Sheet Navigation Bar -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding PreviousSheetCommand}" Content="{DynamicResource Str_PrevSheet}" 
                                        Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Padding="12,5" Cursor="Hand"/>
                                <TextBlock Text="{Binding CurrentSheetNumberDisplay}" FontWeight="Bold" FontSize="13" Foreground="#334155" 
                                           VerticalAlignment="Center" Margin="14,0"/>
                                <Button Command="{Binding NextSheetCommand}" Content="{DynamicResource Str_NextSheet}" 
                                        Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Padding="12,5" Cursor="Hand"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_Zoom}" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,8,0"/>
                                <Button Command="{Binding ZoomOutCommand}" Content="-" Width="28" Height="26" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand"/>
                                <Button Command="{Binding ZoomFitCommand}" Content="{Binding ZoomLevel, StringFormat={}{0:P0}}" 
                                        Width="55" Height="26" Background="#F1F5F9" BorderBrush="#CBD5E1" Margin="4,0" Cursor="Hand"/>
                                <Button Command="{Binding ZoomInCommand}" Content="+" Width="28" Height="26" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Case B: Empty State (When HasPages is False) -->
                <Border Background="#F8FAFC"
                        Visibility="{Binding HasPages, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <Border Width="80" Height="80" Background="#EFF6FF" CornerRadius="40" Margin="0,0,0,20" HorizontalAlignment="Center">
                            <TextBlock Text="🖨️" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="{DynamicResource Str_PiPrintReady}" FontSize="24" FontWeight="Bold" Foreground="#1E293B" 
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="{DynamicResource Str_EmptyStateInstructions}"
                                   FontSize="14" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Command="{Binding LoadSampleCommand}" Background="#3B82F6" Foreground="White" 
                                    FontWeight="SemiBold" Padding="16,10" BorderThickness="0" Margin="6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{DynamicResource Str_LoadSampleReport}"/>
                            </Button>

                            <Button Command="{Binding OpenFileCommand}" Background="#E2E8F0" Foreground="#334155" 
                                    FontWeight="SemiBold" Padding="16,10" BorderThickness="0" Margin="6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{DynamicResource Str_OpenSpoolDoc}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Column 3: Right Print Settings & Output -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Section: Target Printer -->
                        <TextBlock Text="{DynamicResource Str_TargetPrinter}" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding InstalledPrinters}" SelectedItem="{Binding SelectedPrinter}" 
                                  DisplayMemberPath="Name" Padding="8,6" Margin="0,0,0,16"/>

                        <!-- Section: Duplex Mode -->
                        <TextBlock Text="{DynamicResource Str_DuplexSection}" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,6"/>
                        <StackPanel Margin="0,0,0,16">
                            <RadioButton Content="{DynamicResource Str_DuplexSimplex}" IsChecked="True" Margin="0,3"/>
                            <RadioButton Content="{DynamicResource Str_DuplexHardware}" Margin="0,3"/>
                            <RadioButton Content="{DynamicResource Str_DuplexManual}" Margin="0,3" ToolTip="{DynamicResource Str_DuplexManualTip}"/>
                        </StackPanel>

                        <Separator Background="#E2E8F0" Margin="0,0,0,16"/>

                        <!-- Section: Watermark & Annotations -->
                        <TextBlock Text="{DynamicResource Str_Watermark}" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding CurrentWatermark}" SelectedValuePath="Tag" Padding="8,6" Margin="0,0,0,8">
                            <ComboBoxItem Content="{DynamicResource Str_WmNone}" Tag="{x:Static models:WatermarkType.None}" IsSelected="True"/>
                            <ComboBoxItem Content="{DynamicResource Str_WmDraft}" Tag="{x:Static models:WatermarkType.Draft}"/>
                            <ComboBoxItem Content="{DynamicResource Str_WmConfidential}" Tag="{x:Static models:WatermarkType.Confidential}"/>
                            <ComboBoxItem Content="{DynamicResource Str_WmCopy}" Tag="{x:Static models:WatermarkType.Copy}"/>
                            <ComboBoxItem Content="{DynamicResource Str_WmCustom}" Tag="{x:Static models:WatermarkType.Custom}"/>
                        </ComboBox>

                        <TextBox Text="{Binding CustomWatermarkText, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsCustomWatermark, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Padding="8,5" Margin="0,0,0,16"/>

                        <!-- Section: Ink & Toner Saver -->
                        <TextBlock Text="{DynamicResource Str_Economy}" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,6"/>
                        <CheckBox Content="{DynamicResource Str_ForceGrayscale}" IsChecked="{Binding IsGrayscale}" Margin="0,0,0,16"
                                  ToolTip="{DynamicResource Str_GrayscaleTip}"/>

                        <!-- Copies -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str_Copies}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#334155"/>
                            <TextBox Grid.Column="1" Text="{Binding Copies}" Padding="6,4" TextAlignment="Center"/>
                        </Grid>

                        <!-- Primary Print Buttons -->
                        <Button Command="{Binding PrintCommand}" Background="#16A34A" Foreground="White" 
                                FontSize="16" FontWeight="Bold" Padding="0,12" BorderThickness="0" Margin="0,0,0,10" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{DynamicResource Str_PrintNow}" HorizontalAlignment="Center"/>
                        </Button>

                        <Button Command="{Binding SaveAsPdfCommand}" Content="{DynamicResource Str_SavePdf}" 
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Padding="0,9" Margin="0,0,0,8" Cursor="Hand"/>

                        <Button Command="{Binding SaveAsXpsCommand}" Content="{DynamicResource Str_SaveXps}" 
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Padding="0,9" Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <Border Grid.Row="3" Background="#0F172A" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource Str_WatcherActive}" Foreground="#A7F3D0" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
