<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- App Title & Header -->
    <sys:String x:Key="Str_AppTitle">PiPrint - Vista previa de impresión y organizador</sys:String>
    <sys:String x:Key="Str_AppSubtitle">Vista previa de impresión y organizador de páginas</sys:String>
    <sys:String x:Key="Str_OpenDocument">📂 Abrir documento</sys:String>
    <sys:String x:Key="Str_LoadSample">📑 Cargar muestra</sys:String>
    <sys:String x:Key="Str_ClearAll">🗑️ Limpiar todo</sys:String>

    <!-- Toolbar & Layout Modes -->
    <sys:String x:Key="Str_LayoutMode">Modo de diseño:</sys:String>
    <sys:String x:Key="Str_Layout1Up">1 por página (Estándar)</sys:String>
    <sys:String x:Key="Str_Layout2Up">2 por página</sys:String>
    <sys:String x:Key="Str_Layout4Up">4 por página</sys:String>
    <sys:String x:Key="Str_Layout8Up">8 por página</sys:String>
    <sys:String x:Key="Str_LayoutBooklet">📖 Folleto</sys:String>
    <sys:String x:Key="Str_RemoveBlanks">🧹 Quitar páginas en blanco</sys:String>
    <sys:String x:Key="Str_Rotate90">↻ Girar 90°</sys:String>
    <sys:String x:Key="Str_DeletePage">❌ Eliminar página</sys:String>

    <!-- Left Gallery -->
    <sys:String x:Key="Str_PageOrganizer">Organizador de páginas</sys:String>
    <sys:String x:Key="Str_PageNumberPrefix">Página</sys:String>
    <sys:String x:Key="Str_RotationLabel">Rotación: {0}°</sys:String>
    <sys:String x:Key="Str_BlankBadge">EN BLANCO</sys:String>
    <sys:String x:Key="Str_PageMoved">Página movida a la posición {0}.</sys:String>

    <!-- Center Preview & Empty State -->
    <sys:String x:Key="Str_PiPrintReady">PiPrint está listo</sys:String>
    <sys:String x:Key="Str_EmptyStateInstructions">Imprima cualquier documento desde Word, Chrome, Bloc de notas o Adobe Reader y elija 'PiPrint' como impresora.</sys:String>
    <sys:String x:Key="Str_LoadSampleReport">📑 Cargar informe de muestra</sys:String>
    <sys:String x:Key="Str_OpenSpoolDoc">📂 Abrir archivo de impresión</sys:String>
    <sys:String x:Key="Str_PrevSheet">◀ Hoja anterior</sys:String>
    <sys:String x:Key="Str_NextSheet">Siguiente hoja ▶</sys:String>
    <sys:String x:Key="Str_Zoom">Zoom:</sys:String>
    <sys:String x:Key="Str_Side1">Cara 1 (Anverso)</sys:String>
    <sys:String x:Key="Str_Side2">Cara 2 (Reverso)</sys:String>
    <sys:String x:Key="Str_Landscape">Horizontal</sys:String>
    <sys:String x:Key="Str_Portrait">Vertical</sys:String>
    <sys:String x:Key="Str_BlankPage">[Página en blanco]</sys:String>

    <!-- Right Settings Panel -->
    <sys:String x:Key="Str_TargetPrinter">Impresora de destino</sys:String>
    <sys:String x:Key="Str_DuplexSection">Doble cara (Dúplex)</sys:String>
    <sys:String x:Key="Str_DuplexSimplex">Una cara (Simplex)</sys:String>
    <sys:String x:Key="Str_DuplexHardware">Dúplex automático (Impresora)</sys:String>
    <sys:String x:Key="Str_DuplexManual">Asistente de doble cara manual</sys:String>
    <sys:String x:Key="Str_DuplexManualTip">Imprime primero el anverso, le pide voltear el papel y luego imprime el reverso</sys:String>
    <sys:String x:Key="Str_Watermark">Marca de agua</sys:String>
    <sys:String x:Key="Str_WmNone">Ninguna</sys:String>
    <sys:String x:Key="Str_WmDraft">BORRADOR</sys:String>
    <sys:String x:Key="Str_WmConfidential">CONFIDENCIAL</sys:String>
    <sys:String x:Key="Str_WmCopy">COPIA</sys:String>
    <sys:String x:Key="Str_WmCustom">Texto personalizado</sys:String>
    <sys:String x:Key="Str_Economy">Ahorro de tinta y tóner</sys:String>
    <sys:String x:Key="Str_ForceGrayscale">Forzar escala de grises / Blanco y negro</sys:String>
    <sys:String x:Key="Str_GrayscaleTip">Ahorra tinta de color convirtiendo el documento a monocromo</sys:String>
    <sys:String x:Key="Str_Copies">Copias:</sys:String>
    <sys:String x:Key="Str_PrintNow">🖨️  Imprimir ahora</sys:String>
    <sys:String x:Key="Str_SavePdf">📄 Guardar como PDF</sys:String>
    <sys:String x:Key="Str_SaveXps">💾 Guardar como XPS</sys:String>

    <!-- Status Bar & Language -->
    <sys:String x:Key="Str_Language">Idioma</sys:String>
    <sys:String x:Key="Str_WatcherActive">Servicio de captura PiPrint activo</sys:String>
    <sys:String x:Key="Str_StatusReady">PiPrint está listo. Esperando trabajos de impresión...</sys:String>

</ResourceDictionary>
